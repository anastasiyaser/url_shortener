{% extends 'base.html.twig' %}

{% block title %}{{ 'title.login'|trans }}{% endblock %}

{% block body %}
    <div class="row justify-content-center mt-5">
        <div class="col-md-4">
            <h1 class="h3 mb-4 fw-normal">{{ 'title.login_form'|trans }}</h1>

            <form method="post" action="{{ path('app_login') }}">
                {% if error %}
                    <div class="alert alert-danger rounded-0 mb-3">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                {% if app.user %}
                    <div class="alert alert-info rounded-0 mb-3">
                        {{ 'logged_in_as'|trans({'%username%': app.user.userIdentifier}) }},
                        <a href="{{ logout_path() }}" class="alert-link">{{ 'action.logout'|trans }}</a>
                    </div>
                {% endif %}

                <div class="mb-3">
                    <label for="username" class="form-label">{{ 'label.email'|trans }}</label>
                    <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control rounded-0" autocomplete="email" required autofocus>
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label">{{ 'label.password'|trans }}</label>
                    <input type="password" name="_password" id="password" class="form-control rounded-0" autocomplete="current-password" required>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button class="btn btn-primary rounded-0 w-100 mt-2" type="submit">
                    {{ 'action.login'|trans }}
                </button>
                <a href="{{ path('url_index') }}" class="btn btn-outline-secondary rounded-0 w-100 mt-2" title="{{ 'action.back_to_list'|trans }}">
                    {{ 'action.back_to_list'|trans }}
                </a>
            </form>
        </div>
    </div>
{% endblock %}
