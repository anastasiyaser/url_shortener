{% extends 'base.html.twig' %}

{% block title %}{{ 'title.change_password'|trans }}{% endblock %}

{% block body %}
    <div class="row justify-content-center mt-5">
        <div class="col-md-4">
            <h1 class="h3 mb-4 fw-normal">{{ 'title.change_password'|trans }}</h1>

            {{ form_start(changePasswordForm) }}

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }} rounded-0 alert-dismissible fade show mb-3" role="alert">
                        {{ message|trans }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}
            {% endfor %}

            {# Разделяем form_row на явные блоки: лейбл (на всю ширину) и поле ввода #}
            <div class="mb-3">
                {{ form_label(changePasswordForm.oldPassword, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(changePasswordForm.oldPassword, {'attr': {'class': 'form-control rounded-0'}}) }}
                {{ form_errors(changePasswordForm.oldPassword) }}
            </div>

            <div class="mb-3">
                {{ form_label(changePasswordForm.plainPassword.first, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(changePasswordForm.plainPassword.first, {'attr': {'class': 'form-control rounded-0'}}) }}
                {{ form_errors(changePasswordForm.plainPassword.first) }}
            </div>

            <div class="mb-3">
                {{ form_label(changePasswordForm.plainPassword.second, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(changePasswordForm.plainPassword.second, {'attr': {'class': 'form-control rounded-0'}}) }}
                {{ form_errors(changePasswordForm.plainPassword.second) }}
            </div>

            <button type="submit" class="btn btn-primary rounded-0 w-100 mt-2">
                {{ 'action.save'|trans }}
            </button>
            <a href="{{ path('url_index') }}" class="btn btn-outline-secondary rounded-0 w-100 mt-2" title="{{ 'action.back_to_list'|trans }}">
                {{ 'action.back_to_list'|trans }}
            </a>

            {{ form_end(changePasswordForm) }}
        </div>
    </div>
{% endblock %}
