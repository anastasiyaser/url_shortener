{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.tag_create'|trans }}
{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>{{ 'title.tag_create'|trans }}</h1>

    {{ form_start(form) }}
    {# 1. Выводим поля по очереди, чтобы они не перемешивались с кнопками #}
    {{ form_row(form.name) }}
    <div class="d-flex justify-content-between align-items-center mt-4">
        <a href="{{ url('tag_index') }}" class="btn btn-link">
            {{ 'action.back_to_list'|trans }}
        </a>
        <button type="submit" class="btn btn-primary">
            {{ 'action.save'|trans }}
        </button>
    </div>
    {{ form_end(form) }}
</div>
{% endblock %}
