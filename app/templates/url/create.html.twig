{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.url_create'|trans }}
{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>{{ 'title.url_create'|trans }}</h1>

        {{ form_start(form) }}

        {# DODAJEMY OBSŁUGĘ BŁĘDÓW ZGODNIE Z SZABLONEM PROFESORA #}
        {% if false == form.vars.valid %}
            {% include 'default/_single_alert_message.html.twig' with {
                type: 'danger',
                message: 'message.form_error'|trans,
            }%}
        {% endif %}

        {% if form.shortCode is defined %}
            {{ form_row(form.shortCode) }}
        {% endif %}

        {{ form_row(form.originalUrl) }}
        {{ form_row(form.guestEmail) }}

        {{ form_label(form.tags) }}

        <div class="border rounded p-3" style="max-height: 150px; overflow-y: auto; background-color: #f8f9fa;">
            {{ form_widget(form.tags) }}
        </div>

        <div class="d-flex justify-content-between align-items-center mt-4">
            <a href="{{ url('url_index') }}" class="btn btn-link">
                {{ 'action.back_to_list'|trans }}
            </a>
            <button type="submit" class="btn btn-primary">
                {{ 'action.save'|trans }}
            </button>
        </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
