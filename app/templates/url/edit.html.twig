{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.url_edit'|trans({'%id%': url.id|default('')}) }}
{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>{{ 'title.url_edit'|trans }}</h1>

        {{ form_start(form) }}
        {# 1. Выводим поля по очереди, чтобы они не перемешивались с кнопками #}
        {{ form_row(form.originalUrl) }}
        {{ form_label(form.tags) }}

        <div class="border rounded p-3" style="max-height: 150px; overflow-y: auto; background-color: #f8f9fa;">
            {{ form_widget(form.tags) }}
        </div>

        <div class="d-flex justify-content-between align-items-center mt-4">
            <a href="{{ url('url_index') }}" class="btn btn-link">
                {{ 'action.back_to_list'|trans }}
            </a>
            <button type="submit" class="btn btn-primary">
                {{ 'action.save'|trans }}
            </button>
        </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
