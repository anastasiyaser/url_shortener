{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.url_details'|trans({'%id%': url.id|default('')}) }}
{% endblock %}

{% block body %}
    <h1>{{ 'title.url_details'|trans({'%id%': url.id|default('')}) }}</h1>
    {% if url is defined and url|length %}
        <dl class="dl-horizontal">
            <dt>{{ 'label.id'|trans }}</dt>
            <dd>{{ url.id }}</dd>
            <dt>{{ 'label.created_at'|trans }}</dt>
            <dd>{{ url.createdAt|date('Y/m/d') }}</dd>
            <dt>{{ 'label.updated_at'|trans }}</dt>
            <dd>{{ url.updatedAt|date('Y/m/d') }}</dd>
            <dt>{{ 'label.short_code'|trans }}</dt>
            <dd>{{  url.shortCode }}</dd>
            <dt>{{ 'label.tags'|trans }}</dt>
            <dd>
                {% for tag in url.tags %}
                    {{ tag.name }}{% if not loop.last %}, {% endif %}
                {% else %}
                    -
                {% endfor %}
            </dd>
        </dl>
        <p>
            <a href="{{ url('url_index') }}" title="{{ 'action.back_to_list'|trans }}">
                {{ 'action.back_to_list'|trans }}
            </a>
        </p>
    {% else %}
        <p>
            {{ 'message.record_not_found'|trans }}
        </p>
    {% endif %}
{% endblock %}
