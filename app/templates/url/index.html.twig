{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.url_list'|trans }}
{% endblock %}

{% block body %}
    <div class="d-flex align-items-center gap-3 mb-4">
        <h1 class="m-0">{{ 'title.url_list'|trans }}</h1>

        <div class="d-flex gap-2">
            {% if app.request.query.has('tagId') %}
                <a href="{{ url('url_index') }}" class="btn btn-secondary btn-sm">
                    {{ 'action.clear_filter'|trans }}
                </a>
            {% endif %}

            <a href="{{ url('url_create') }}" class="btn btn-success btn-sm">
                <i class="bi bi-plus-circle"></i> {{ 'action.create_url'|trans }}
            </a>
        </div>
    </div>

    {% if pagination is defined and pagination.items|length %}

        <div class="navigation text-center mb-3">
            {{ knp_pagination_render(pagination) }}
        </div>

        <table class="table table-striped align-middle">
            <thead>
            <tr>
                <th>{{ knp_pagination_sortable(pagination, 'label.id'|trans, 'url.id') }}</th>
                <th>{{ knp_pagination_sortable(pagination, 'label.created_at'|trans, 'url.createdAt') }}</th>
                <th>{{ knp_pagination_sortable(pagination, 'label.updated_at'|trans, 'url.updatedAt') }}</th>
                <th>{{ 'label.short_code'|trans }}</th>
                <th>{{ 'label.guest_email'|trans }}</th>
                <th>{{ knp_pagination_sortable(pagination, 'label.click_count'|trans, 'url.clickCount') }}</th>
                <th>{{ 'label.tags'|trans }}</th>
                <th class="text-end">{{ 'label.actions'|trans }}</th>
            </tr>
            </thead>
            <tbody>
            {% for url in pagination.items %}
                <tr>
                    <td>{{ url.id }}</td>
                    <td>{{ url.createdAt|format_date('long') }}</td>
                    <td>{{ url.updatedAt|format_date('long') }}</td>
                    <td>
                        <a href="{{ url('url_redirect', {'shortCode': url.shortCode}) }}" target="_blank">
                            <code>{{ url.shortCode }}</code>
                        </a>
                    </td>
                    <td>{{ url.guestEmail }}</td>
                    <td><span class="badge bg-secondary">{{ url.clickCount }}</span></td>
                    <td>
                        {% set colors = ['primary-subtle', 'success-subtle', 'danger-subtle', 'warning-subtle', 'info-subtle', 'secondary-subtle'] %}
                        {% for tag in url.tags %}
                            {% set color_class = colors[loop.index0 % colors|length] %}

                            <a href="{{ url('url_index', {'tagId' : tag.id}) }}"
                               class="badge bg-{{ color_class }} text-dark border border-{{ color_class|replace({'-subtle': ''}) }} text-decoration-none me-1 mb-1">
                                #{{ tag.name }}
                            </a>
                        {% endfor %}
                    </td>
                    <td class="text-end">
                        <div class="btn-group" role="group">
                            {% if is_granted('URL_VIEW', url) %}
                                <a class="btn btn-sm btn-outline-primary" href="{{ url('url_view', {shortCode: url.shortCode}) }}" title="{{ 'action.view'|trans }}">
                                    {{ 'action.view'|trans }}
                                </a>
                            {% endif %}
                            {% if is_granted('URL_EDIT', url) %}
                                <a class="btn btn-sm btn-outline-warning" href="{{ url('url_edit', {shortCode: url.shortCode}) }}" title="{{ 'action.edit'|trans }}">
                                    {{ 'action.edit'|trans }}
                                </a>
                            {% endif %}
                            {% if is_granted('URL_DELETE', url) %}
                                <a class="btn btn-sm btn-outline-danger" href="{{ url('url_delete', {shortCode: url.shortCode}) }}" title="{{ 'action.delete'|trans }}">
                                    {{ 'action.delete'|trans }}
                                </a>
                            {% endif %}
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        <div class="navigation text-center mt-3">
            {{ knp_pagination_render(pagination) }}
        </div>

    {% else %}
        {% include 'default/_single_alert_message.html.twig' with {
            type: 'warning',
            message: 'message.empty_list'|trans
        } %}
    {% endif %}
{% endblock %}
