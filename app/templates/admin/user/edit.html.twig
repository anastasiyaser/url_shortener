{% extends 'base.html.twig' %}

{% block title %}{{ 'title.user_edit'|trans }}{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h2 class="h5 mb-0">{{ 'title.user_edit'|trans }}</h2>
                </div>
                <div class="card-body">
                    {{ form_start(form) }}
                    {{ form_widget(form) }}

                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <a href="{{ url('admin_user_index') }}" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> {{ 'action.back_to_list'|trans }}
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg"></i> {{ 'action.save'|trans }}
                        </button>
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
