{% extends 'base.html.twig' %}

{% block title %}{{ 'title.user_list'|trans }}{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-12">
            <h1 class="h3 mb-4">{{ 'title.user_list'|trans }}</h1>

            {% if users is not empty %}
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>{{ 'label.email'|trans }}</th>
                            <th>{{ 'label.roles'|trans }}</th>
                            <th class="text-end">{{ 'action.actions'|trans }}</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for user in users %}
                            <tr>
                                <td>{{ user.id }}</td>
                                <td>{{ user.email }}</td>
                                <td>
                                    {% for role in user.roles %}
                                        <span class="badge bg-secondary">{{ role }}</span>
                                    {% endfor %}
                                </td>
                                <td class="text-end">
                                    <a href="{{ url('admin_user_edit', {id: user.id}) }}" class="btn btn-sm btn-outline-primary me-1">
                                        <i class="bi bi-pencil"></i> {{ 'action.edit'|trans }}
                                    </a>
                                    <a href="{{ url('admin_user_change_password', {id: user.id}) }}" class="btn btn-sm btn-outline-warning">
                                        <i class="bi bi-key"></i> {{ 'action.change_password'|trans }}
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="alert alert-info">
                    {{ 'message.empty_list'|trans }}
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
